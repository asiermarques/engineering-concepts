---
/**
 * Static walkthrough: the Simulator's version without JavaScript. Every step with what each
 * actor does, the state after it and its note, so no information is lost (requirement 003, FR-006).
 */
import type { SimulatorLabels } from '../../i18n/ui';
import type { SimulatorSequence } from './schema';

interface Props {
  sequence: Omit<SimulatorSequence, 'concept'>;
  labels: SimulatorLabels;
}
const { sequence, labels } = Astro.props;
const { caption, actors, steps } = sequence;
---

<figure class="walkthrough">
  <figcaption>{caption}</figcaption>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">#</th>
          {actors.map((actor) => <th scope="col">{actor}</th>)}
          <th scope="col">{labels.state}</th>
        </tr>
      </thead>
      <tbody>
        {
          steps.map((step, index) => (
            <Fragment>
              <tr class="walkthrough__step">
                <th scope="row">{index + 1}</th>
                {step.cells.map((cell) => <td>{cell}</td>)}
                <td class="walkthrough__state">{step.state}</td>
              </tr>
              {step.note && (
                <tr class="walkthrough__note">
                  <td colspan={actors.length + 2}>
                    <strong>{labels.note}:</strong> {step.note}
                  </td>
                </tr>
              )}
            </Fragment>
          ))
        }
      </tbody>
    </table>
  </div>
</figure>
