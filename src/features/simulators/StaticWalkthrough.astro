---
/**
 * Static walkthrough: a step-by-step table of what a simulator will show.
 * It can later be replaced by the interactive simulator at the same place in the MDX.
 */
interface Props {
  /** Describes the sequence in one sentence; doubles as the text alternative. */
  caption: string;
  columns: string[];
  rows: string[][];
}
const { caption, columns, rows } = Astro.props;
---

<figure class="walkthrough">
  <figcaption>{caption}</figcaption>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">#</th>
          {columns.map((column) => <th scope="col">{column}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row, index) => (
            <tr>
              <th scope="row">{index + 1}</th>
              {row.map((cell) => <td>{cell}</td>)}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</figure>
