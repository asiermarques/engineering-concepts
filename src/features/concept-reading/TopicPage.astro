---
import { render } from 'astro:content';
import { entryLocale, loadContent } from '../content-validation/loadContent';
import { ui, type Locale } from '../../i18n/ui';
import Layout from './Layout.astro';
import { sortConcepts } from './navigation';
import { conceptPath, homePath } from './paths';

interface Props {
  locale: Locale;
  topicId: string;
  /** URL of this topic in each locale. */
  alternates: Record<Locale, string>;
}
const { locale, topicId, alternates } = Astro.props;
const t = ui[locale];

const content = await loadContent();
const topic = content.topics.find((entry) => entryLocale(entry.id) === locale && entry.data.id === topicId);
if (!topic) throw new Error(`No topic "${topicId}" found for locale "${locale}"`);
const { Content } = await render(topic);
const concepts = sortConcepts(
  content.concepts.filter((c) => entryLocale(c.id) === locale && c.data.topic === topic.data.id).map((c) => ({ ...c, order: c.data.order })),
);
const first = concepts[0];
const pad = (n: number) => String(n).padStart(2, '0');
---

<Layout locale={locale} title={topic.data.title} description={topic.data.summary} alternates={alternates} width="wide">
  <p class="breadcrumb back-link"><a href={homePath(locale)}><span aria-hidden="true">◀ </span>{t.allTopics}</a></p>
  <section class="hero">
    <p class="kicker">
      <span class="kicker__chip">{t.topicLabel}</span>
      <span>{concepts.length} {t.conceptsUnit}</span>
    </p>
    <h1>{topic.data.title}</h1>
    <p class="hero__summary">{topic.data.summary}</p>
    {
      first && (
        <a class="button button--start" href={conceptPath(locale, first.data.id)}>
          <span aria-hidden="true" class="button__glyph">▶</span> {t.start}: {first.data.title}
        </a>
      )
    }
  </section>

  <div class="topic-layout">
    <div class="prose prose--intro">
      <Content />
    </div>

    <section class="map" aria-labelledby="concepts-heading">
      <h2 id="concepts-heading" class="section-title">{t.topicConcepts}</h2>
      <ol class="concept-list stage-map" data-testid="concept-list" data-progress-map data-labels={JSON.stringify(t.progress)}>
        {
          concepts.map((concept, index) => (
            <li class="stage" style={`--i:${index}`} data-concept-id={concept.data.id}>
              <span class="stage__num" aria-hidden="true">{pad(index + 1)}</span>
              <div class="stage__body">
                <h2>
                  <a class="stage__link" href={conceptPath(locale, concept.data.id)}>{concept.data.title}</a>
                </h2>
                <p class="stage__status" data-testid="concept-status"></p>
                <p class="concept-list__objective">
                  <strong>{t.learningObjective}:</strong> {concept.data.learningObjective}
                </p>
              </div>
              <span class="stage__go" aria-hidden="true">▶</span>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Layout>

<script>
  import { getProgressStore } from '../progress/browser';
  import { paintTopicMap } from '../progress/paint';

  const map = document.querySelector<HTMLElement>('[data-progress-map]');
  if (map) {
    const store = getProgressStore();
    const labels = JSON.parse(map.dataset.labels ?? '{}');
    const paint = () => paintTopicMap(map, store.get(), labels);
    paint();
    store.subscribe(paint);
  }
</script>
