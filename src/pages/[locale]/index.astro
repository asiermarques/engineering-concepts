---
import HomePage from '../../features/concept-reading/HomePage.astro';
import { locales } from '../../i18n/ui';

export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }));
---

<HomePage locale={Astro.params.locale as 'en' | 'es'} alternates={{ en: '/en/', es: '/es/' }} />
